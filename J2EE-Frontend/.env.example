# ==================================
# FRONTEND ENVIRONMENT VARIABLES
# ==================================
# Copy this file to .env and update with your values

# ==================================
# API CONFIGURATION
# ==================================
# Backend API Base URL
# PHẢI chứa kèm context path `/api` của backend (server.servlet.context-path=/api).
# Prod build dùng `/api` (relative) để nginx proxy.
VITE_API_BASE_URL=http://localhost:8080/api

# ==================================
# WEBSOCKET CONFIGURATION
# ==================================
# WebSocket URL for real-time updates (cũng phải chứa `/api`)
VITE_WS_BASE_URL=http://localhost:8080/api/ws

# ==================================
# APPLICATION CONFIGURATION
# ==================================
# Application environment (development, production)
VITE_APP_ENV=development

# Application version
VITE_APP_VERSION=1.0.0
